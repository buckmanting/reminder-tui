{
	"name": "reminder-tui",
	"version": "1.0.0",
	"license": "MIT",
	"bin": {
		"reminders-tui": "dist/cli.js"
	},
	"type": "module",
	"engines": {
		"node": ">=16"
	},
	"scripts": {
		"build": "vite build && chmod +x dist/cli.js",
		"prepare": "vite build && chmod +x dist/cli.js",
		"dev": "vite build --watch",
		"start": "vite build && node dist/cli.js",
		"test": "prettier --check . && xo && ava"
	},
	"files": [
		"dist"
	],
	"dependencies": {
		"@kessler/gemma": "^4.0.1",
		"ink": "^4.1.0",
		"react": "^18.2.0"
	},
	"devDependencies": {
		"@types/node": "^25.9.1",
		"@types/react": "^19.2.15",
		"@vdemedes/prettier-config": "^2.0.1",
		"@vitejs/plugin-react": "^6.0.2",
		"ava": "^5.2.0",
		"chalk": "^5.2.0",
		"eslint-config-xo-react": "^0.27.0",
		"eslint-plugin-react": "^7.32.2",
		"eslint-plugin-react-hooks": "^4.6.0",
		"ink-testing-library": "^3.0.0",
		"prettier": "^2.8.7",
		"typescript": "^6.0.3",
		"vite": "^8.0.13",
		"xo": "^0.53.1"
	},
	"ava": {
		"environmentVariables": {
			"NODE_NO_WARNINGS": "1"
		},
		"nodeArguments": [
			"--loader=import-jsx"
		]
	},
	"xo": {
		"extends": "xo-react",
		"prettier": true,
		"rules": {
			"react/prop-types": "off"
		}
	},
	"prettier": "@vdemedes/prettier-config"
}
